# Copy to .env and fill in. Never commit the real .env.

# OpenAI — letter extraction (vision) and, later, substitution proposals/reviews.
OPENAI_API_KEY=

# Alpaca — PAPER keys only. Real-money trading is prohibited.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Must remain true. Any other value is rejected; there is no live mode.
ALPACA_PAPER=true
