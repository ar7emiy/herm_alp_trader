# Copy to .env and fill in. Never commit the real .env.

# OpenAI — letter extraction (vision) and, later, substitution proposals/reviews.
OPENAI_API_KEY=

# Alpaca — use PAPER keys until Phase 7 (docs/10-build-plan.md).
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# true = paper endpoint (default). Only an explicit "false" selects live.
ALPACA_PAPER=true
